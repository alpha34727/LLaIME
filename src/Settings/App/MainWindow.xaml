<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LLaIME.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LLaIME 設定">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" Language="zh-TW">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar, as in Windows Settings: icon and name over the Mica background. -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
        <TextBlock Text="LLaIME 設定" Style="{StaticResource CaptionTextBlockStyle}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView x:Name="Nav" Grid.Row="1"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    OpenPaneLength="280"
                    SelectionChanged="Nav_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="一般" Tag="general" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="選字模型與加速" Tag="model">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="下載模型" Tag="downloads">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="詞庫" Tag="lexicons">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="使用者詞庫" Tag="userdict">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="關於" Tag="about">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
