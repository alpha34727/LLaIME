<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLaIME.Settings.Pages.LexiconPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer>
    <StackPanel MaxWidth="1000" Padding="56,0,56,40" Spacing="{StaticResource SettingsCardSpacing}">
      <TextBlock Text="詞庫" Style="{StaticResource PageTitleTextBlockStyle}" />
      <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                 Text="選字時從勾選的詞庫中找出符合讀音的詞。同一個詞出現在多個詞庫時取最高的詞頻。變更會在各應用程式的下一次組字時套用，不必重新開啟程式。您自己的詞彙與學習紀錄不受這裡影響。" />

      <TextBlock Text="詞庫來源" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
      <StackPanel x:Name="LexiconList" Spacing="{StaticResource SettingsCardSpacing}" />

      <TextBlock Text="匯入" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
      <tk:SettingsCard Header="匯入詞庫"
                       Description="把詞表檔案加成一個新的詞庫，例如專業領域的術語。支援 McBopomofo（注音 詞 分數，或 詞 注音）、新酷音 tsi.csv／tsi.src，以及一行一個詞的純文字詞表（自動標注音）。檔案可為 UTF-8、UTF-16 或 Big5。">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B5;" /></tk:SettingsCard.HeaderIcon>
        <Button Content="選擇檔案…" Click="Import_Click" />
      </tk:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
